# =============================================================================
# Medplum Docker Compose Environment Variables
# Copy this file to .env and update the values.
# =============================================================================

# --- Image Versions ---
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
MEDPLUM_SERVER_IMAGE=medplum/medplum-server:latest
MEDPLUM_APP_IMAGE=medplum/medplum-app:latest

# --- PostgreSQL ---
POSTGRES_USER=medplum
POSTGRES_PASSWORD=changeme
POSTGRES_DB=medplum

# --- Redis ---
REDIS_PASSWORD=changeme

# --- Ports ---
POSTGRES_PORT=5432
REDIS_PORT=6379
MEDPLUM_SERVER_PORT=8103
MEDPLUM_APP_PORT=3000

# --- Medplum Server ---
MEDPLUM_PORT=8103
MEDPLUM_BASE_URL=http://localhost:8103
MEDPLUM_APP_BASE_URL=http://localhost:3000
MEDPLUM_DATABASE_HOST=postgres
MEDPLUM_DATABASE_PORT=5432
MEDPLUM_DATABASE_DBNAME=medplum
MEDPLUM_DATABASE_USERNAME=medplum
MEDPLUM_DATABASE_PASSWORD=changeme
MEDPLUM_DATABASE_SSL=false
MEDPLUM_DATABASE_ISOLATION_LEVEL=REPEATABLE READ
MEDPLUM_DATABASE_STATEMENT_TIMEOUT=60000
MEDPLUM_REDIS_HOST=redis
MEDPLUM_REDIS_PORT=6379
MEDPLUM_REDIS_PASSWORD=changeme
MEDPLUM_MAX_JSON_SIZE=1mb
MEDPLUM_ALLOWED_ORIGINS=*
